<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings kanso components announce to accessibility services. They are never drawn on
  screen, so they carry no visual weight — but they must be translatable, which is why they
  live here rather than as Kotlin string literals.
-->
<resources>
    <!-- Announced by KansoButton while its `loading` spinner is showing. -->
    <string name="kanso_loading">Loading</string>
    <!-- KansoPasswordField's reveal toggle, when the value is currently masked. -->
    <string name="kanso_show_password">Show password</string>
    <!-- KansoPasswordField's reveal toggle, when the value is currently visible. -->
    <string name="kanso_hide_password">Hide password</string>
    <!-- KansoErrorState's default retry label. Drawn on screen, unlike the strings above. -->
    <string name="kanso_retry">Retry</string>
    <!-- KansoBackButton, which carries no visible label. -->
    <string name="kanso_back">Back</string>
    <!-- Announced in place of KansoSkeleton's placeholder bars while content loads. -->
    <string name="kanso_loading_content">Loading content</string>
</resources>
