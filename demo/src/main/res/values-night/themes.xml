<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark counterpart of values/themes.xml, so the window drawn before the first Compose
      frame is not a white flash on a device in dark mode.
    -->
    <style name="Theme.Kanso.Splash" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
